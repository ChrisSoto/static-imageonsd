{%- macro heroSection(fields, phone) -%}

<div class="section-full">
  <div class="section flex flex-row px-4 xl:px-0">

    <div class="w-full sm:w-8/12 md:w-5/12 lg:w-4/12 relative">

      {# mobile image #}
      {%- if fields.images.fields.mobile -%}
        <img eleventy:widths="300" class="absolute z-[-10] bottom-0 right-0 object-scale-down object-right w-1/2" src="https:{{ fields.images.fields.mobile.fields.file.url }}" alt="ImageOn San Diego custom t-shirt and embroidery service shop">
      {%- else -%}
        <img eleventy:widths="300" class="absolute z-[-10] bottom-0 right-0 object-scale-down object-right w-1/2" src="/assets/mobile-background.webp" alt="ImageOn San Diego custom t-shirt and embroidery service shop">
      {%- endif -%}

      <h1 class="text-black text-3xl mb-4">{{ fields.h1 | safe }}</h1>
      <div class="sub-heading font-bold mb-4">{{ fields.subHeading | safe }}</div>


      <div class="flex gap-x-4">
        <a onclick="gtag_phone_call();" href="tel:{{phone}}" class="text-white bg-red-500 hover:bg-red-500 hover:text-white hover:underline hover:shadow-none text-sm rounded-full mb-4 p-2 px-6 sm:text-sm poppins-medium shadow-md">CALL @ {{phone}}</a>
        <img class="object-none object-left" src="/assets/phone-arrow.webp" alt="arrow point to phone number">
      </div>

      <script>
        function gtag_phone_call() {
          window.dataLayer.push({
            'event': 'phone_click'
          })
        }
      </script>

      <div class="short-copy font-bold">
        {{ fields.text |safe }}
      </div>
    </div>

    <div class="flex-1 relative">

      {# desktop images #}
      {%- if fields.images.fields.desktop -%}
        <img eleventy:widths="900" class="h-[500px] object-none object-left z-[-1]" src="https:{{ fields.images.fields.desktop.fields.file.url }}" alt="ImageOn San Diego custom t-shirt and embroidery service shop">
      {%- else -%}
        <img eleventy:widths="900" class="h-[500px] object-left object-none z-[-1]" src="/assets/imageon-custom-t-background.webp" alt="ImageOn San Diego custom t-shirt and embroidery service shop">
      {%- endif -%}
      
    </div>

  </div>
</div>

{%- endmacro -%}