{%- macro seoPageLayoutSelector(title, banner, copy, gallery, faq) -%}

<div id="banner" class="section-full h-[400px] lg:h-[500px] xl:h-[650px] mb-8 relative">
  <img class="absolute z-[-1] object-cover object-right-top w-full h-full" src="https:{{ banner.file.url }}" alt="{{ banner.title }}">
  <div class="section flex flex-row"> 
    <div class="flex h-auto w-7/12">
      <div class="flex justify-center items-center text-center w-full h-[400px] lg:h-[500px] xl:h-[650px]">
        <h1 class="text-white text-5xl mb-4 hidden md:block text-shadow select-none">{{ title | safe }}</h1>
      </div>
    </div>
    <div class="flex flex-1"></div>
  </div>
</div>

<div class="section">
  <div class="flex flex-col md:flex-row p-4 pt-0">
    <div class="w-full md:w-7/12 pr-4">
    <h1 class="md:hidden">{{ title | safe }}</h1>
      {% from 'macros/copy-section.njk' import copySection %}
      {{ copySection(copy) }}
    </div>
    <div class="flex-1">
      {% include "partials/contact-form-skinny.njk" %}
    </div>
  </div>
</div>

{% from 'macros/gallery-section.njk' import gallerySection %}
{{ gallerySection(gallery) }}

{% from 'macros/faq-section.njk' import faqSection %}
{{ faqSection(faq) }}

{%- endmacro -%}