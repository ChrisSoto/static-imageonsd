{% if  'santee' in page.url or 'oceanside' in page.url or 'downtown-san-diego' in page.url %}

<div class="section">
  <div class="flex flex-col md:flex-row justify-between items-center">
    <a class="mt-4 md:mt-0 text-xl pl-4 xl:pl-0" href="mailto:{{ email }}">{{ email }}</a>
    <div class="phone flex flex-col sm:flex-row justify-center items-center sm:justify-end gap-x-4 p-4 pt-0 md:pt-4">
      <span class="flex gap-x-2 text-sm sm:text-base sm:pb-0">
        <a id="call-now-link" class="text-red-500 no-underline" href="tel:{{ phoneNumber }}">{{ phoneNumber }}</a>
      </span>
      <span class="address flex gap-x-2 text-sm sm:text-base">
        <a onclick="gtag_phone_call();" class="text-gray-800 no-underline" href="{{ googleMap }}">{{ address }}</a>
      </span>
      <script>
        function gtag_phone_call() {
          window.dataLayer.push({
            'event': 'phone_click'
          })
        }
      </script>
    </div>
  </div>
</div>

{% else %}

<div class="section">
  <div class="flex flex-col md:flex-row justify-center items-center text-xl font-bold gap-4 py-4">
    Locations: <a href="/city/santee">Santee</a> | <a href="/city/oceanside">Oceanside</a> | <a href="/city/downtown-san-diego">Downtown San Diego</a>
  </div>
</div>

{% endif %}