{%- if city.city == "Santee" -%}
  {%- set shopSlug = "santee" -%}
  {%- set shopName = "Santee" -%}
  {%- set shopIntro = "Image On’s Santee shop serves East County businesses, schools, teams, events, and individuals who need custom apparel made locally. Bring finished artwork or ask our team for help preparing a design for production." -%}
  {%- set visitNote = "The shop is on Town Center Parkway in Santee’s Town Center area. Use the directions link for the current route and parking access." -%}
{%- elif city.city == "Downtown San Diego" -%}
  {%- set shopSlug = "downtown-san-diego" -%}
  {%- set shopName = "Downtown San Diego" -%}
  {%- set shopIntro = "Image On’s Downtown San Diego shop serves local businesses, conventions, events, teams, and residents from its Market Street location. It is a convenient central shop for one-off custom pieces and larger apparel orders." -%}
  {%- set visitNote = "The shop is on Market Street near Park & Market in the East Village. Downtown street and garage parking availability varies, so allow extra time before a scheduled pickup." -%}
{%- elif city.city == "Oceanside" -%}
  {%- set shopSlug = "oceanside" -%}
  {%- set shopName = "Oceanside" -%}
  {%- set shopIntro = "Image On’s Oceanside shop serves North County businesses, schools, teams, events, and individuals from its South Coast Highway location. Customers can work directly with the local team on artwork, garment choices, and production timing." -%}
  {%- set visitNote = "The shop is on South Coast Highway in South Oceanside. Use the directions link to plan your route and check parking access before your visit." -%}
{%- endif -%}

{%- if shopSlug -%}
<section class="section mx-4 p-4 mb-16 bg-zinc-50 rounded border" aria-labelledby="{{ shopSlug }}-shop-details">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <h2 id="{{ shopSlug }}-shop-details">Custom apparel made at our {{ shopName }} shop</h2>
      <p>{{ shopIntro }}</p>
      <p>We offer full-color <a href="/services/custom-t-shirts/{{ shopSlug }}/">DTG and DTF custom T-shirt printing</a>, plus <a href="/services/embroidery/{{ shopSlug }}/">custom embroidery for hats and apparel</a>. There is no minimum order for many projects, so you can order one personalized item or ask about quantity pricing for a larger run.</p>
      <p><strong>Need it today?</strong> Same-day production may be available for qualifying orders. Timing depends on artwork readiness, garment availability, decoration method, and quantity. Call the shop before visiting if you have a same-day deadline.</p>
    </div>
    <div>
      <h3>Plan your visit</h3>
      <p>{{ visitNote }}</p>
      <p>Planning to walk in? Visit during the posted hours below. Calling first is recommended for same-day work, specialty garments, and larger orders.</p>
      <address class="not-italic mb-4">
        <strong>Image On {{ shopName }}</strong><br>
        <a href="{{ googleMap }}">{{ address }}</a><br>
        <a href="tel:{{ phoneNumber }}">{{ phoneNumber }}</a>
      </address>
      <p><strong>Hours:</strong><br>Monday–Friday: 9:00 AM–7:00 PM<br>Saturday: 9:00 AM–4:30 PM</p>
      <a class="inline-block bg-red-500 text-white font-bold rounded p-3" href="{{ googleMap }}">Get directions to the {{ shopName }} shop</a>
    </div>
  </div>
</section>
{%- endif -%}
