<script>
  // Find the anchor tag (assuming it's the only one with this specific class combination)
  const flashingLink = document.querySelectorAll('a#flashing-link');

  // Set up the flashing interval
  let isFlashed = false;

  const flashInterval = setInterval(() => {
    for (let i = 0; i < flashingLink.length; i++) {
      if (isFlashed) {
        // Reset to original state: red background, white text
        flashingLink[i].classList.remove('bg-white', 'text-red-500');
        flashingLink[i].classList.add('bg-red-500', 'text-white');
      } else {
        // Flash state: white background, red text
        flashingLink[i].classList.remove('bg-red-500', 'text-white');
        flashingLink[i].classList.add('bg-white', 'text-red-500');
      }
    }

    isFlashed = !isFlashed;
  }, 500);
</script>