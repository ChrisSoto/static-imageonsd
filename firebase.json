{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/leads/login",
        "function": {
          "functionId": "leadsLogin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/leads/logout",
        "function": {
          "functionId": "leadsLogout",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/leads/stats",
        "function": {
          "functionId": "getLeadStats",
          "region": "us-central1"
        }
      }
    ]
  }
}
