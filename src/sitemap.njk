---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
      <loc>{{ site.url }}/</loc>
      <lastmod>{{ site.time }}</lastmod>
  </url>

{% for page in services %}
  <url>
      <loc>{{ site.url }}/services/{{ page.fields.slug }}/</loc>
      <lastmod>{{ page.sys.updatedAt | w3c }}</lastmod>
  </url>
{% endfor %}

{% for page in cityServices %}
  <url>
      <loc>{{ site.url }}/services/{{ page.serviceSlug }}/{{ page.city | slugify }}/</loc>
      <lastmod>{{ page.sys.updatedAt | w3c }}</lastmod>
  </url>
{% endfor %}


{% for page in seoPages %}
  {% set seoPageSlug = page.fields.title | slugify %}
  {% if seoPageSlug != 'custom-embroidery-services' and seoPageSlug != 'custom-t-shirt-printing' %}
  <url>
      <loc>{{ site.url }}/{{ seoPageSlug }}/</loc>
      <lastmod>{{ page.sys.updatedAt | w3c }}</lastmod>
  </url>
  {% endif %}
{% endfor %}

{% set localSeoPages = [
  '/custom-t-shirt-printing-in-santee-ca/',
  '/dtf-work-shirt-printing-in-santee-ca/',
  '/dtg-photo-t-shirt-printing-in-santee-ca/',
  '/custom-hat-embroidery-in-santee-ca/',
  '/custom-team-shirts-and-hats-in-santee-ca/',
  '/dtg-dtf-vs-screen-printing/'
] %}
{% for localPage in localSeoPages %}
  <url>
      <loc>{{ site.url }}{{ localPage }}</loc>
      <lastmod>{{ site.time }}</lastmod>
  </url>
{% endfor %}

  <url>
      <loc>{{ site.url }}/blog/</loc>
  </url>

{% for page in blog %}
  <url>
      <loc>{{ site.url }}/blog/{{ page.fields.title | slugify }}/</loc>
      <lastmod>{{ page.sys.updatedAt | w3c }}</lastmod>
  </url>
{% endfor %}

</urlset>
