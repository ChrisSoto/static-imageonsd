---
pagination:
  data: services
  size: 1
  alias: service
permalink: "services/{{ service.fields.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ service.fields.metaTitle or home.metaTitle }}"
  description: "{{ service.fields.metaDescription or home.metaDescription }}"
  email: "{{ home.eMail }}"
  phoneNumber: "{{ home.phoneNumber }}"
  googleMap: "{{ home.googleMap }}"
  cityMap: "{{ home.cityMap }}"
  address: "{{ home.address }}"
---

{%- include "partials/phone-address.njk" -%}

{% from 'macros/default-layout-selector.njk' import defaultLayoutSelector %}

{{ defaultLayoutSelector(
    hero=service.fields.heroSection.fields,
    gallery=service.fields.gallerySection.fields,
    copy=service.fields.copySection.fields, 
    faq=service.fields.faqSection.fields,
    phone=phoneNumber,
    page=page)
}}

{% if service.fields.slug == "custom-t-shirts" %}
<aside class="section p-4 mb-8" aria-labelledby="printing-method-guide-title">
  <div class="p-6 rounded-xl bg-zinc-100">
    <h2 id="printing-method-guide-title" class="text-2xl font-bold text-gray-900">Which shirt-printing method should you choose?</h2>
    <p class="text-gray-700">See how digital garment printing compares for small orders, full-color artwork, rush projects, and large simple-color runs.</p>
    <a href="/dtg-dtf-vs-screen-printing/">Read our DTG vs screen printing guide →</a>
  </div>
</aside>
{% endif %}
